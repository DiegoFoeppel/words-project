{
  "compilerOptions": {
    "target": "es2022", // Specify ECMAScript target version
    "module": "commonjs", // Specify module code generation
    "allowJs": true, // Allow JavaScript files to be compiled
    "checkJs": false, // Set to true if you want type-checking on regular JS files
    "outDir": "./dist", // Redirect output structure to the directory
    "rootDir": "./src", // Specify the root folder of input files
    "strict": true, // Enable all strict type-checking options
    "esModuleInterop": true, // Emit additional JavaScript to ease importing CommonJS modules
    "skipLibCheck": true // Skip type checking of declaration files (.d.ts)
  },
  "include": ["src/**/*", "drizzle.config.ts"] // Explicitly tell TS to compile files in your source folder
}
